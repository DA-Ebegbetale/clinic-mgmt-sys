{
    "name": "Clinic Mgmt. System",
    "description": "A secured, Role-Based Clinic Mgmt. system with integrated EHR, Audit and Archival Sub-systems",
    "type": "project",
    "require": {
        "php": "^8.1",
        "dompdf/dompdf": "^3.1",
        "vlucas/phpdotenv": "^5.5"
    },
     "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
        "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
